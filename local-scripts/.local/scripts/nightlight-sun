#!/usr/bin/env python3
"""Schedule hyprsunset's night light from today's sunrise and sunset.

Writes ~/.config/hypr/hyprsunset.conf with a sunrise profile (no tint) and a
sunset profile (warm), then restarts hyprsunset so the right one applies now.
Run daily by nightlight-sun.timer and at login by nightlight-sun.service.

Location defaults to the coordinates of the system timezone's city, from
/usr/share/zoneinfo/zone1970.tab. Override with NIGHTLIGHT_LAT and
NIGHTLIGHT_LON (decimal degrees, north and east positive).
"""

import math
import os
import re
import subprocess
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo

TEMPERATURE = int(os.environ.get("NIGHTLIGHT_TEMP", 4000))
FALLBACK = ("07:00", "19:00")  # Used when the sun doesn't rise or set today
CONF = Path.home() / ".config/hypr/hyprsunset.conf"


def system_timezone():
    return os.path.realpath("/etc/localtime").split("zoneinfo/", 1)[1]


def dms(value, deg_digits):
    sign = -1 if value[0] == "-" else 1
    digits = value[1:]
    parts = [digits[:deg_digits], digits[deg_digits:deg_digits + 2], digits[deg_digits + 2:]]
    d, m, s = (int(p) if p else 0 for p in parts)
    return sign * (d + m / 60 + s / 3600)


def timezone_location(tz):
    for line in Path("/usr/share/zoneinfo/zone1970.tab").read_text().splitlines():
        fields = line.split("\t")
        if len(fields) >= 3 and fields[2] == tz:
            lat, lon = re.match(r"([+-]\d+)([+-]\d+)", fields[1]).groups()
            return dms(lat, 2), dms(lon, 3)
    raise SystemExit(f"No coordinates for timezone {tz}; set NIGHTLIGHT_LAT and NIGHTLIGHT_LON")


def sun_event(day, lat, lon, tz, rising):
    """Sunrise or sunset as local time, using the NOAA almanac algorithm."""
    rad, deg = math.radians, math.degrees
    lng_hour = lon / 15
    t = day.timetuple().tm_yday + ((6 if rising else 18) - lng_hour) / 24
    m = 0.9856 * t - 3.289
    l = (m + 1.916 * math.sin(rad(m)) + 0.020 * math.sin(rad(2 * m)) + 282.634) % 360
    ra = deg(math.atan(0.91764 * math.tan(rad(l)))) % 360
    ra = (ra + (l // 90 - ra // 90) * 90) / 15
    sin_dec = 0.39782 * math.sin(rad(l))
    cos_dec = math.cos(math.asin(sin_dec))
    cos_h = (math.cos(rad(90.833)) - sin_dec * math.sin(rad(lat))) / (cos_dec * math.cos(rad(lat)))
    if not -1 <= cos_h <= 1:
        return None
    h = (360 - deg(math.acos(cos_h)) if rising else deg(math.acos(cos_h))) / 15
    ut = (h + ra - 0.06571 * t - 6.622 - lng_hour) % 24
    utc = datetime(day.year, day.month, day.day, tzinfo=timezone.utc) + timedelta(hours=ut)
    return utc.astimezone(tz).strftime("%H:%M")


def main():
    tz_name = system_timezone()
    if "NIGHTLIGHT_LAT" in os.environ and "NIGHTLIGHT_LON" in os.environ:
        lat, lon = float(os.environ["NIGHTLIGHT_LAT"]), float(os.environ["NIGHTLIGHT_LON"])
    else:
        lat, lon = timezone_location(tz_name)

    tz = ZoneInfo(tz_name)
    today = datetime.now(tz).date()
    sunrise = sun_event(today, lat, lon, tz, rising=True) or FALLBACK[0]
    sunset = sun_event(today, lat, lon, tz, rising=False) or FALLBACK[1]

    CONF.write_text(
        f"# Generated by ~/.local/scripts/nightlight-sun for {today} at {lat:.2f}, {lon:.2f}.\n"
        "# Edits are overwritten daily. Change the script in omarchy-dots instead.\n\n"
        f"profile {{\n    time = {sunrise}\n    identity = true\n}}\n\n"
        f"profile {{\n    time = {sunset}\n    temperature = {TEMPERATURE}\n}}\n"
    )
    print(f"sunrise {sunrise}, sunset {sunset} ({tz_name}, {lat:.2f}, {lon:.2f})")

    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.run(["pkill", "-x", "hyprsunset"])
        # A transient unit of its own, so it outlives this script's oneshot service
        subprocess.run(["systemd-run", "--user", "--quiet", "--collect",
                        "--slice=app-graphical.slice", f"--unit=app-Hyprland-hyprsunset-{os.getpid()}",
                        "--description=hyprsunset", "--", "hyprsunset"], check=True)


if __name__ == "__main__":
    main()
